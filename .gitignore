# ============================================================
# FireGuard Cochabamba — .gitignore
# Node.js + React Native + Expo + TypeScript
# ============================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build output ---
dist/
build/
out/
lib/

# --- TypeScript ---
*.tsbuildinfo

# --- Environment variables (keep .env.example) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Expo ---
.expo/
.expo-shared/
web-build/

# --- React Native / Android ---
android/
*.apk
*.aab
*.keystore
!debug.keystore

# --- React Native / iOS ---
ios/
*.ipa
*.xcarchive
Pods/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# --- OS generated ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Testing ---
coverage/
.nyc_output/

# --- Docker ---
.dockerignore

# --- Misc ---
*.pem
.vercel
.netlify
